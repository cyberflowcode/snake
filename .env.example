# ==============================================================================
# Laravel Application Configuration
# ==============================================================================
APP_NAME="Snake Arena"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# Database Configuration (MySQL)
# Railway provides: MYSQL_URL or MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snake
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# Cache, Session & Queue
# ==============================================================================
BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional Redis for distributed state & scaling
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# Laravel Reverb WebSocket Server Configuration
# ==============================================================================
REVERB_APP_ID=snake-app-id
REVERB_APP_KEY=snake-app-key
REVERB_APP_SECRET=snake-app-secret

# Internal Reverb daemon binding (used by reverb service)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Public Reverb host & port (used by browsers to connect)
# On Railway, point REVERB_HOST to the public Railway domain for your Reverb service
REVERB_HOST=your-reverb-service.up.railway.app
REVERB_PORT=443
REVERB_SCHEME=https

# Pusher client fallback credentials (mirrors Reverb)
PUSHER_APP_ID="${REVERB_APP_ID}"
PUSHER_APP_KEY="${REVERB_APP_KEY}"
PUSHER_APP_SECRET="${REVERB_APP_SECRET}"
PUSHER_HOST="${REVERB_HOST}"
PUSHER_PORT="${REVERB_PORT}"
PUSHER_SCHEME="${REVERB_SCHEME}"
PUSHER_APP_CLUSTER=mt1

# ==============================================================================
# Game Engine Configuration
# ==============================================================================
GAME_TICK_RATE=10
GAME_ARENA_WIDTH=2400
GAME_ARENA_HEIGHT=2400
GAME_MAX_PLAYERS=8
GAME_FOOD_COUNT=120
GAME_ROOM_EXPIRE_MINUTES=60
